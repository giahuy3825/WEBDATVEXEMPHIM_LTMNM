@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - MOVANA</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #060922;
            color: #fff;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.95rem;
        }

        .content-wrapper {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 15px;
            box-sizing: border-box;
        }

        /* ================= HEADER ================= */
        .header-container {
            position: fixed;
            top: 0;
            width: 100%;
            background-color: #060922;
            border-bottom: 1px solid #15183c;
            z-index: 9999;
        }

        .navbar-top {
            padding: 0.8rem 0;
            position: relative;
            z-index: 2000; /* Cao hơn sub-navbar để popup menu không bị che */
        }

            .navbar-top .content-wrapper,
            .sub-navbar .content-wrapper {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .navbar-brand img {
            height: 55px;
            width: auto;
        }

        .search-box {
            position: relative;
            width: 350px;
        }

            .search-box input {
                width: 100%;
                height: 42px;
                border-radius: 21px;
                border: 1px solid rgba(255,255,255,0.2);
                background: rgba(255,255,255,0.05);
                padding-left: 42px;
                color: #fff;
                outline: none;
                transition: 0.3s;
            }

                .search-box input:focus {
                    background: #fff;
                    color: #000;
                }

            .search-box i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #999;
            }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 25px;
        }

            .nav-right .nav-link {
                color: #fff !important;
                font-weight: 600;
                cursor: pointer;
            }

                .nav-right .nav-link:hover {
                    color: #f9e000 !important;
                }

        .flag-icon {
            height: 18px;
            margin-right: 5px;
        }

        /* Custom Dropdown Style */
        .dropdown-menu {
            background-color: #12173b;
            border: 1px solid #ffeb00;
            border-radius: 10px;
            margin-top: 10px;
            z-index: 99999 !important; /* Đảm bảo luôn nổi trên mọi thành phần */
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8) !important;
        }

        .dropdown-item {
            color: #fff;
            font-weight: 500;
            padding: 10px 20px;
        }

            .dropdown-item:hover {
                background-color: #ffeb00;
                color: #000;
            }

        /* ================= SUB NAV ================= */
        .sub-navbar {
            background-color: #060922;
            border-top: 1px solid #15183c;
            border-bottom: 1px solid #15183c;
            padding: 0.4rem 0;
            overflow: visible !important;
            position: relative;
            z-index: 1000; /* Thấp hơn navbar-top để không đè menu user */
        }

        .sub-navbar .content-wrapper {
            max-width: 1400px;
            overflow: visible !important;
        }

        .sub-nav-wrapper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 6px;
            flex-wrap: nowrap;
        }

        .sub-nav-left, .sub-nav-right {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-shrink: 0;
        }

        .sub-nav-item {
            white-space: nowrap;
            flex-shrink: 0;
            position: relative;
        }

        .sub-nav-item a {
            color: #fff !important;
            font-weight: 600;
            padding: 0.45rem 0.65rem;
            text-decoration: none;
            text-transform: uppercase;
            font-size: 0.8rem;
            white-space: nowrap !important;
            display: inline-flex;
            align-items: center;
            border-radius: 4px;
            transition: all 0.2s ease-in-out;
            letter-spacing: 0.2px;
            cursor: pointer;
        }

            .sub-nav-item a:hover {
                color: #f9e000 !important;
                background-color: rgba(255, 235, 0, 0.08);
            }

            .sub-nav-item a i {
                margin-right: 5px;
                font-size: 0.85rem;
            }

        /* Hover & Click Dropdown cho Chọn rạp & Thể loại */
        .rap-hover, .theloai-hover {
            position: relative;
        }

        .rap-hover:hover .rap-menu,
        .rap-hover.show .rap-menu,
        .theloai-hover:hover .theloai-menu,
        .theloai-hover.show .theloai-menu {
            display: grid !important;
            position: absolute !important;
            top: 100% !important;
            left: 0 !important;
            z-index: 999999 !important;
            background-color: #121536 !important;
            border: 1px solid #232756 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7) !important;
            min-width: 680px;
            border-radius: 8px;
            padding: 15px 25px;
        }

        /* ================= MAIN ================= */
        .main-content {
            padding-top: 160px;
            min-height: 70vh;
        }

        /* ================= FOOTER ================= */
        footer {
            background-color: #060922;
            padding: 40px 0;
            margin-top: 60px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.12);
        }

        .footer-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: #e6e6f0;
            margin-left: 22px;
            text-decoration: none;
            font-weight: 500;
        }

            .footer-links a:hover {
                color: #f9e000;
            }

        .footer-middle {
            text-align: center;
            font-size: 0.85rem;
            color: #d0d3ff;
            line-height: 1.8;
        }
    </style>
</head>

<body>

    @if (ViewBag.HideHeader != true)
    {
        <div class="header-container">
            <div class="navbar-top">
                <div class="content-wrapper">

                    <a class="navbar-brand" href="@Url.Action("PhimDangChieu", "Home")">
                        <img src="/Images/logomavana.png" alt="MOVANA" />
                    </a>

                    <div class="d-flex align-items-center" style="gap: 25px;">
                        <form method="post" action="/Home/TimKiemPhim" class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" name="tenphim" placeholder="Tìm phim..." autocomplete="off" />
                        </form>

                        <div class="nav-right">

                            @if (Session["USER_SESSION"] != null)
                            {
                                var userSession = (doan3.Models.UserLogin)Session["USER_SESSION"];
                                <div class="dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-user-circle"></i> @userSession.FullName
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">

                                        @if (userSession.GroupID != "1")
                                        {
                                            @Html.ActionLink("Thông tin cá nhân", "Index", "ThongTinCaNhan", null, new { @class = "dropdown-item" })
                                            @Html.ActionLink("Lịch sử giao dịch", "LichSuDatVe", "LichSuGiaoDich", null, new { @class = "dropdown-item" })

                                            <div class="dropdown-divider" style="border-top: 1px solid rgba(255,255,255,0.1)"></div>
                                        }

                                        @Html.ActionLink("Đăng xuất", "SignOut", "Login", null, new { @class = "dropdown-item" })
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="loginDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-user-circle"></i> Đăng nhập
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="loginDropdown">
                                        @Html.ActionLink("Đăng nhập", "Index_DangNhap", "Login", null, new { @class = "dropdown-item" })
                                        @Html.ActionLink("Đăng ký", "Index_DangKy", "Register", null, new { @class = "dropdown-item" })
                                    </div>
                                </div>
                            }

                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="langDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <img src="/Images/vietnam_flag.png" class="flag-icon" /> VN
                                </a>
                                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="langDropdown">
                                    <a class="dropdown-item" href="#"><img src="/Images/vietnam_flag.png" class="flag-icon" /> Vietnamese</a>
                                    <a class="dropdown-item" href="#"><img src="/Images/english_flag.png" class="flag-icon" /> English</a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            @{
                string role = "Customer";
                if (Session["SESSION_GROUP"] != null)
                {
                    var groups = Session["SESSION_GROUP"] as List<string>;
                    if (groups != null && groups.Count > 0) { role = groups[0]; }
                }
            }

            <nav class="sub-navbar">
                <div class="content-wrapper">
                    <div class="sub-nav-wrapper">
                        <div class="sub-nav-left">
                            @if (role == "Customer")
                            {
                                <div class="sub-nav-item dropdown rap-hover">
                                    <a href="#" class="dropdown-toggle"><i class="fas fa-map-marker-alt mr-1"></i> Chọn rạp</a>
                                    @Html.Action("TenRap_PartialView", "TenRap")
                                </div>
                                <div class="sub-nav-item dropdown theloai-hover">
                                    <a href="#" class="dropdown-toggle">Thể loại</a>
                                    @Html.Action("TheLoai_PartialView", "TheLoai")
                                </div>
                            }

                            @if (role == "Staff")
                            {
                                <div class="sub-nav-item dropdown rap-hover">
                                    <a href="#" class="dropdown-toggle text-white"><i class="fas fa-map-marker-alt"></i> Chọn rạp</a>
                                    @Html.Action("TenRap_PartialView", "TenRap")
                                </div>
                                <div class="sub-nav-item dropdown theloai-hover">
                                    <a href="#" class="dropdown-toggle text-white">Thể loại</a>
                                    @Html.Action("TheLoai_PartialView", "TheLoai")
                                </div>
                                <div class="sub-nav-item">
                                    <a href="@Url.Action("Index", "HoTroKhachHang")" style="color:#ffeb00 !important">
                                        <i class="fas fa-headset mr-1"></i> Hỗ Trợ Khách Hàng
                                    </a>
                                </div>
                            }

                            @if (role == "Admin")
                            {
                                <div class="sub-nav-item dropdown rap-hover">
                                    <a href="#" class="dropdown-toggle"><i class="fas fa-map-marker-alt mr-1"></i> Chọn rạp</a>
                                    @Html.Action("TenRap_PartialView", "TenRap")
                                </div>
                                <div class="sub-nav-item dropdown theloai-hover">
                                    <a href="#" class="dropdown-toggle">Thể loại</a>
                                    @Html.Action("TheLoai_PartialView", "TheLoai")
                                </div>
                                <div class="sub-nav-item">
                                    <a href="@Url.Action("QuanLyAdmin", "ChucNang_Admin")" style="color:#ffeb00 !important">
                                        <i class="fas fa-user-shield"></i> Cài Đặt Admin
                                    </a>
                                </div>
                            }
                        </div>

                        <div class="sub-nav-right">
                            <div class="sub-nav-item">
                                <a href="@Url.Action("Index", "Neo4j")" style="color: #ffeb00 !important; font-weight: 700;">
                                    <i class="fas fa-magic mr-1"></i> Gợi Ý Phim (Neo4j)
                                </a>
                            </div>

                            <div class="sub-nav-item">
                                <a href="@Url.Action("Index", "MgdbPromotion")" style="color: #00e676 !important; font-weight: 700;">
                                    <i class="fas fa-gift mr-1"></i> Voucher & Khuyến Mãi
                                </a>
                            </div>

                            <div class="sub-nav-item">
                                <a href="@Url.Action("Index", "MgdbCustomerFeedback")" style="color: #00e676 !important; font-weight: 700;">
                                    <i class="fas fa-headset mr-1"></i> Hỗ Trợ & Khiếu Nại
                                </a>
                            </div>

                            <div class="sub-nav-item">
                                <a href="@Url.Action("GioiThieu", "Home")" style="color: #ffeb00 !important; font-weight: 700;">
                                    <i class="fas fa-info-circle mr-1"></i> Giới thiệu
                                </a>
                            </div>

                            <div class="sub-nav-item">
                                <a href="@Url.Action("ChinhSachTichDiem", "Home")" style="color: #f9e000 !important; font-weight: 700;">
                                    <i class="fa fa-star mr-1"></i> Chính Sách & Ưu Đãi
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
    }

    <div class="main-content" style="@(ViewBag.HideHeader == true ? "padding-top: 0 !important;" : "")">
        <div class="content-wrapper">
            <div class="py-2">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer>
        <div class="content-wrapper">
            <div class="footer-top">
                <div class="footer-copy">© @DateTime.Now.Year MOVANA Cinema. All rights reserved.</div>
                <div class="footer-links">
                    <a href="@Url.Action("Privacy","Home")">Chính sách bảo mật</a>
                    <a href="@Url.Action("Contact","Home")">Liên hệ</a>
                    <a href="#">Hỏi & đáp</a>
                </div>
            </div>
            <div class="footer-middle">
                <strong>CÔNG TY CỔ PHẦN MOVANA ENTERTAINMENT</strong><br />
                Địa chỉ: 135 Hai Bà Trưng, Phường Bến Nghé, Quận 1, TP.HCM<br />
                Hotline: 1900 1234 | Email: support@movana.vn
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>

    <script>
        $(document).ready(function () {
            // Cho phép người dùng CLICK vào nút Chọn rạp / Thể loại để mở menu
            $('.rap-hover > a, .theloai-hover > a').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var parent = $(this).closest('.sub-nav-item');
                $('.rap-hover, .theloai-hover').not(parent).removeClass('show');
                parent.toggleClass('show');
            });

            // Đóng menu khi click ra ngoài
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.rap-hover, .theloai-hover').length) {
                    $('.rap-hover, .theloai-hover').removeClass('show');
                }
            });
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>